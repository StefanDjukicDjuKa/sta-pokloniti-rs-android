<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:background="@color/white"
        android:visibility="visible">

        <ImageView
            android:id="@+id/loadingLogo"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_marginBottom="30dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />

        <rs.stapokloniti.app.CircularProgressView
            android:id="@+id/circularProgress"
            android:layout_width="118dp"
            android:layout_height="118dp" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/loading_text"
            android:textColor="@color/muted_text"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:background="@color/white"
        android:visibility="gone">

        <ImageView
            android:id="@+id/offlineLogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginBottom="22dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />

        <TextView
            android:id="@+id/offlineMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/offline_text"
            android:textColor="@color/brand_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <ImageView
            android:id="@+id/refreshIcon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_button"
            android:fontFamily="sans"
            android:text="@string/refresh"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
